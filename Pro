        for _, F in ipairs(c:GetChildren()) do
            if F:IsA("Model") and not a:GetPlayerFromCharacter(F) then
                local G = F.PrimaryPart or F:FindFirstChildWhichIsA("BasePart")
                if G and (G.Position - E).Magnitude > 400 then
                    for _, H in ipairs(F:GetDescendants()) do
                        if H:IsA("BasePart") then
