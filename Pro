    if v then
        for _, w in ipairs(v:GetDescendants()) do
            if w:IsA("ImageLabel") or w:IsA("ImageButton") then
                w.Image = ""
            elseif w:IsA("ScreenGui") then
                if not w.Enabled then
                    w.ResetOnSpawn = false
                    w:ClearAllChildren()
