local function q(r)
    if r:IsA("ParticleEmitter") or r:IsA("Trail") or r:IsA("SelectionBox") 
       or r:IsA("BillboardGui") or r:IsA("Light") or r:IsA("Sparkles") 
       or r:IsA("Fire") or r:IsA("Smoke") or r:IsA("Beam") or r:IsA("Explosion") 
       or r:IsA("Highlight") or r:IsA("Firework") then
        r.Enabled = false
    elseif r:IsA("Decal") or r:IsA("Texture") then
        r.Transparency = 1
    elseif r:IsA("BasePart") then
        r.Material = Enum.Material.SmoothPlastic
        r.CastShadow = false
        r.Reflectance = 0
        if not (k.Character and r:IsDescendantOf(k.Character)) then
            r.CanTouch = false
            r.CanQuery = false
        end
    elseif r:IsA("MeshPart") then
        r.Material = Enum.Material.SmoothPlastic
        r.CastShadow = false
        r.TextureID = ""
    elseif r:IsA("Sound") then
        r.RollOffMaxDistance = 5
        if not r.IsPlaying then
            r:Stop()
        end
    end
end

